cat > .gitignore << 'EOF'
# Environment
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environment
venv/
env/
.venv/

# Model files (besar, simpan di HuggingFace Hub)
model/saved_model/*.bin
model/saved_model/*.pt
model/saved_model/*.safetensors

# Data mentah (JANGAN UPLOAD ke GitHub)
data/raw/*
!data/raw/.gitkeep

# Database
*.db
*.sqlite

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
EOF

echo "data/processed/*.csv" >> .gitignore
echo "data/raw/*.csv" >> .gitignore
echo "data/raw/json/" >> .gitignore