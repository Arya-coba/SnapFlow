# SnapFlow — Environment Variables
# Salin file ini ke .env dan isi nilainya
# cp .env.example .env

# ── Groq API (daftar gratis di console.groq.com) ──────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Model config ──────────────────────────────────────────────────────────────
MODEL_PATH=model/saved_model
MODEL_NAME=indobenchmark/indobert-base-p1

# ── App config ────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./snapflow.db
